DATABASE_URL=sqlite:///./omnisage.db
APP_ENV=development
DATA_DIR=.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
JWT_SECRET_KEY=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-value
MODEL_CACHE_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WIKI_CONNECT_TIMEOUT_SECONDS=3
WIKI_READ_TIMEOUT_SECONDS=10
RAG_WORKER_LIMIT=4
VECTOR_WRITE_BATCH_SIZE=32

# Docker Compose / MySQL
MYSQL_DATABASE=omnisage
MYSQL_USER=omnisage
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
